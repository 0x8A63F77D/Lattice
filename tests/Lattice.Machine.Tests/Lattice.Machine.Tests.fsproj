<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <WarningLevel>5</WarningLevel>
    <OtherFlags>--warnaserror</OtherFlags>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="AttachMachineTests.fs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageReference Include="xunit.v3.assert" Version="3.2.2" />
    <PackageReference Include="xunit.v3.core" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" PrivateAssets="all" />
    <!-- FsCheck.Xunit.v3, NOT FsCheck.Xunit — the two are separate package ids for the
         same library against different xunit majors. FsCheck.Xunit is still hard-bound
         to xunit.extensibility.execution [2.4.1, 3.0.0) even at 3.3.4, which is what
         used to pin this project to xunit v2 (issue #16). The .v3 id depends on
         xunit.v3.extensibility.core instead. Do not "correct" this back. -->
    <PackageReference Include="FsCheck.Xunit.v3" Version="3.3.4" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Lattice.Core.Machine\Lattice.Core.Machine.fsproj" />
  </ItemGroup>
</Project>
