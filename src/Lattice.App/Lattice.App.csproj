<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Ship the binary under the app's display name (Lattice.exe / Lattice
         apphost), not the project name Lattice.App. This is the single source of
         the executable name every packaging surface references (Info.plist
         CFBundleExecutable, .desktop Exec); it also becomes the avares assembly
         base (avares://Lattice/...). Root namespace stays Lattice.App. -->
    <AssemblyName>Lattice</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationTitle>Lattice</ApplicationTitle>
    <ResXFileCodeGenerator_PublicClass>true</ResXFileCodeGenerator_PublicClass>
    <ResXFileCodeGenerator_NullForgivingOperators>true</ResXFileCodeGenerator_NullForgivingOperators>
    <!-- Windows PE icon (taskbar/Explorer/Alt-Tab for the .exe). The mark is the
         finalized design package (docs/design/icon), referenced in place rather
         than copied so the generated artifacts stay single-source. -->
    <ApplicationIcon>../../docs/design/icon/windows/lattice.ico</ApplicationIcon>
    <!-- Release tags are v-prefixed (v0.2.0-alpha.1); MinVer strips the prefix. -->
    <MinVerTagPrefix>v</MinVerTagPrefix>
  </PropertyGroup>
  <!-- Release-publish knobs (issue #56). Guarded on RuntimeIdentifier so a
       RID-less `dotnet build` / `dotnet test` (what CI runs) is completely
       unaffected: these engage only for a per-RID `dotnet publish -r <rid>`,
       which is how the packaging scripts and the release workflow build. -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <!-- End users need no .NET install: bundle the runtime. -->
    <SelfContained>true</SelfContained>
    <!-- One executable by default (the Windows portable exe path). The .app
         and AppDir builders opt out (-p:PublishSingleFile=false) because they
         already ship a directory layout with a plain apphost. -->
    <PublishSingleFile>true</PublishSingleFile>
    <!-- Skia/HarfBuzz native libs live inside the single file, self-extracted
         on first run — required for a genuinely single-file Avalonia app. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <!-- Trimming stays OFF: Avalonia resolves controls, converters and styles
         via reflection the trimmer cannot see, so trimming risks a runtime
         MissingMethodException. Left off until proven safe per-RID (see
         packaging/README.md). -->
    <PublishTrimmed>false</PublishTrimmed>
    <!-- ReadyToRun off too: avoids cross-arch crossgen surprises (e.g. building
         osx-x64 on an arm64 runner) and keeps publish fast. -->
    <PublishReadyToRun>false</PublishReadyToRun>
    <!-- Keep the shipped drop clean: no debug symbols, no XML doc files. This is
         the single source for every packaging surface (win zip, mac .app, linux
         AppDir/tarball) — DebugType/DebugSymbols drop this app's own .pdb, and
         AllowedReferenceRelatedFileExtensions (default .pdb;.xml;.pri;…) is
         narrowed so the referenced projects' .pdb + .xml (Lattice.Core.xml,
         Lattice.Boinc.GuiRpc.xml, …) aren't dragged in as reference-related
         files. GenerateDocumentationFile stays ON in the class libs (the GuiRpc
         NuGet still ships its XML) — we just don't COPY docs into the app.
         Only engages for a per-RID publish, so CI's RID-less build/test keeps
         full symbols. Windows-native .pdb (libSkiaSharp/libHarfBuzzSharp) are
         package assets, not reference-related — swept in build-zip.ps1. -->
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <AllowedReferenceRelatedFileExtensions>.none</AllowedReferenceRelatedFileExtensions>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.1" />
    <!-- DataGrid trails the rest of the Avalonia family on purpose: it ships out of
         band and 12.1.1 was never published for it (12.1.0 is the newest). Its own
         dependency is Avalonia >= 12.1.0, so the 12.1.1 core resolves cleanly. Bump
         this to match once a 12.1.1+ DataGrid exists; do not "align" it downward. -->
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="12.1.0" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="FluentAvaloniaUI" Version="3.0.1" />
    <!-- Charting for the M4 Statistics page (issue #148 ruling). Pinned to the exact
         evaluated prerelease — the 2.1.0-dev line has no stable release, so float would
         silently drift the render across builds and break the pixel-gated snapshots. The
         two-layer verification gate and the ScottPlot flip-back trigger are recorded on
         #148; bump this pin deliberately, never via a range. -->
    <PackageReference Include="LiveChartsCore.SkiaSharpView.Avalonia" Version="2.1.0-dev-798" />
    <PackageReference Include="VocaDb.ResXFileCodeGenerator" Version="3.2.1" PrivateAssets="all" />
    <!-- Derive the version from git so an un-stamped local build self-identifies in
         Settings -> About instead of showing the SDK's 1.0.0 default (issue #151):
         a tagged commit -> the tag (v0.2.0-alpha.1 -> 0.2.0-alpha.1); an untagged
         commit -> the latest tag + commit height + short sha (0.2.0-alpha.1.5+abc1234).
         Tag prefix is 'v'. This is also the SINGLE version source for release
         packaging: the scripts derive the .app/.zip/.dmg/.AppImage filename + the
         Info.plist stamp from the same MinVer computation (via minver-cli), so no
         script passes -p:Version anymore. A dry run overrides both the assembly and
         the CLI at once through the MinVerVersionOverride env var. Build-time only
         (PrivateAssets=all): MinVer never flows to consumers of this app. -->
    <PackageReference Include="MinVer" Version="7.0.0" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <!-- Embed the .ico as an Avalonia asset so Window.Icon can load it at
         avares:///Assets/lattice.ico. Link places the out-of-project file at a
         clean logical path; the physical file stays in docs/design/icon. -->
    <AvaloniaResource Include="../../docs/design/icon/windows/lattice.ico" Link="Assets/lattice.ico" />
    <!-- macOS menu-bar tray template glyph (issue #108): monochrome black+alpha PNG
         the OS tints for light/dark menu bars. Only the 36 px (@2x-resolution) master
         is embedded: Avalonia's macOS tray path feeds a SINGLE bitmap to AppKit's
         NSImage(initWithData:) and resizes it to ~18 pt, so the classic @1x/@2x
         filename pair is never density-resolved there — one 36 px rep is crisp at
         18 pt on Retina (2x backing) and downsamples cleanly on 1x. The 18 px PNG and
         the SVG master sit alongside as provenance, un-embedded. -->
    <AvaloniaResource Include="../../docs/design/icon/macos/tray/latticeTrayTemplate@2x.png" Link="Assets/latticeTrayTemplate@2x.png" />
    <!-- Inter Regular for the snooze pill's time digits (issue #181): a LOCAL pin, so the one
         element whose layout is measured off glyph ink renders the same face on every platform
         AND is the face the pixel gates already probe. Only the Regular static face is embedded —
         one weight, ~300 KB — because that is the only one the pill draws; see Assets/Fonts/README.md
         for provenance and Assets/Fonts/OFL.txt for the license the OFL requires us to ship. -->
    <AvaloniaResource Include="Assets/Fonts/Inter-Regular.ttf" />
    <!-- The license travels as a plain file next to the binary (OFL §2 wants it human-readable),
         so every packaging surface picks it up from the publish directory it already copies
         wholesale: Lattice.app/Contents/MacOS/Assets/Fonts/OFL.txt, the same relative path in the
         Windows zip and the Linux AppDir/tarball. -->
    <Content Include="Assets/Fonts/OFL.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Lattice.Core/Lattice.Core.csproj" />
    <ProjectReference Include="../Lattice.App.Aggregation/Lattice.App.Aggregation.fsproj" />
    <!-- Declared, not incidental. Core's public surface hands the App GuiRpc types by
         design (#139's adjudication): HostSnapshot embeds CcStatus / Result / Project /
         Message, IGuiRpcClient is the factory seam the composition root wires, and a
         dozen App files name those types directly. Without this line the App compiled
         only through Core's transitive reference — a dependency that is real but
         undeclared, so a future ProjectReference-hygiene change to Core (PrivateAssets,
         or dropping a type from its surface) would break the App for reasons invisible
         in the App's own file. It is NOT a licence for protocol logic in the App: the
         boundary rule (no RPC calls outside Core) stays, and the App still never
         constructs an RPC op itself. -->
    <ProjectReference Include="../Lattice.Boinc.GuiRpc/Lattice.Boinc.GuiRpc.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Lattice.App.Tests" />
  </ItemGroup>
</Project>
